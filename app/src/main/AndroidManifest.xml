<?xml version="1.0" encoding="utf-8"?>
<!-- Owned by integration. Feature agents: list any manifest change you need in your report. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Messages & calls (optional): the guard checks which app is on screen and covers the real
         Instagram app outside calls. Both are special permissions the user grants in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Messages & calls: Throwback's own message notifications (Android 13+ asks the user), the
         guard's foreground service, and restarting it after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ only lets us see these apps if we name them (used for "Instagram app found"). -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.lite" />
    </queries>

    <application
        android:name=".ThrowbackApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Throwback">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Throwback.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the app icon: "Throwback settings" (there is no settings button on the feed). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Instagram links from other apps. Users enable this once in Android's "Open by default" settings. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.instagram.com" />
                <data android:host="instagram.com" />
            </intent-filter>
        </activity>

        <!-- Messages & calls relay (app.throwback.relay): only Android can bind it, and only after the
             user grants notification access. It reads the Instagram apps' notifications only. -->
        <service
            android:name=".connect.relay.RelayListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Messages & calls guard (app.throwback.guard). targetSdk 34+ needs a foreground service type.
             None of the specific types fits (it is not dataSync, mediaPlayback, location, phoneCall…):
             it watches which app is in front so the hidden Instagram app can't be used outside calls,
             a digital-wellbeing use that Play lists under specialUse. The subtype text is what Play
             review reads; the Play Console declaration must say the same (docs/PLAY_POLICY.md). -->
        <service
            android:name=".connect.guard.GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Digital wellbeing: while the user has connected the Instagram app to Throwback (Settings, Connect, Instagram), detects when that app is opened outside a call or posting and returns the user to Throwback." />
        </service>

        <receiver
            android:name=".connect.guard.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
