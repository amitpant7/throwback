<resources>
    <string name="back">Back</string>

    <!-- A value that isn't known yet, and how TalkBack reads it. -->
    <string name="value_unknown">—</string>
    <string name="value_unknown_description">not known yet</string>
    <!-- TalkBack for a row with a title and a value, e.g. "Filters updated: 20 Nov 2026". -->
