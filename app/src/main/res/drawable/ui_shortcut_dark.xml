<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen shortcut icon (dark). Used by ShortcutManagerCompat.requestPinShortcut; the file name stays
     the same across updates, so shortcuts already on the home screen take the new look. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_bg_dark" />
    <foreground android:drawable="@drawable/ui_shortcut_mark" />
</adaptive-icon>
