    <string name="ui_install_title">Connect Instagram</string>
    <string name="ui_install_body">Instagram only sends notifications to its own app. So the real app stays on your phone, and Throwback keeps you out of it. Log in to the Instagram app with the same account you use in Throwback.</string>
    <string name="ui_install_point_messages">Message alerts open in Throwback</string>
    <string name="ui_install_point_calls">Calls ring and you answer normally</string>
    <string name="ui_install_point_post">Post and add stories with Instagram\'s own editor</string>
    <string name="ui_install_point_guard">Open the Instagram app outside a call and Throwback brings you back</string>
    <string name="ui_install_app_name">Instagram app</string>
    <string name="ui_install_not_installed">Not installed</string>
    <string name="ui_install_installed">Installed</string>
    <string name="ui_install_button">Install</string>
    <string name="ui_install_button_description">Install the Instagram app from the Play Store</string>
    <string name="ui_limit_connect_title">Cover the Instagram app too</string>
    <string name="ui_limit_connect_body">The Instagram app is on this phone, so opening it would skip your daily limit. Connect Instagram to Throwback, and Throwback covers it.</string>
    <string name="ui_limit_connect_button">Connect the Instagram app</string>
    <string name="ui_install_perms">Step 2 asks for three Android permissions, each explained there. Throwback needs them to pass on Instagram\'s notifications and keep you out of its app.</string>
    <string name="ui_install_perms_four">Step 2 asks for four Android permissions, each explained there. Throwback needs them to pass on Instagram\'s notifications and keep you out of its app.</string>
    <string name="ui_install_clones">Only the Instagram app in your main profile is covered. A second copy (in a work profile, a phone\'s dual apps or Private Space) isn\'t.</string>

    <!-- Connect › Instagram: Instagram's notifications must stay on (owner, 2026-11-21, DECISIONS.md #34bb). -->
    <string name="ui_ig_notif_title">Keep Instagram\'s notifications on</string>
    <string name="ui_ig_notif_body">Throwback reads them to pass on messages, ring your calls and see when a story is posted. In Instagram\'s notification settings, keep both groups on. Throwback hides the ones you don\'t need.</string>
    <string name="ui_ig_notif_working">Working: Throwback has seen them this week.</string>
    <string name="ui_ig_notif_check">None from the \'Instagram\' group in 7 days. Check that it\'s on.</string>
