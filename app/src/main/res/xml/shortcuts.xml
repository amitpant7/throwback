<?xml version="1.0" encoding="utf-8"?>
<!-- App-icon long-press shortcuts. Settings lives here because the feed has no Throwback button. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutShortLabel="@string/shortcut_settings_short"
        android:shortcutLongLabel="@string/shortcut_settings_long">
        <intent
            android:action="app.throwback.action.OPEN_SETTINGS"
            android:targetPackage="app.throwback"
            android:targetClass="app.throwback.MainActivity" />
    </shortcut>
</shortcuts>
